{
  "name": "@vnuge/vnlib.browser",
  "version": "0.1.2",
  "author": "Vaughn Nugent",
  "description": "Framework-agnostic JavaScript library for connecting with VNLib Essentials plugins. Optional Vue and VueUse integrations available.",
  "repository": "https://github.com/VnUgE/Plugins.Essentials/tree/master/lib/vnlib.browser",
  "copyright":"Copyright \u00A9 2026 Vaughn Nugent",
  "output": "bin",
  "artifacts": "release.tgz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "axios": "^1.13.6",
    "jose": "^6.1.3",
    "lodash-es": "^4.17.23"
  },
  "peerDependencies": {
    "@vue/reactivity": "^3.x",
    "@vueuse/core": "^14.x"
  },
  "peerDependenciesMeta": {
    "@vue/reactivity": {
      "optional": true
    },
    "@vueuse/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/reactivity": "^3.x",
    "@vueuse/core": "^14.2.1",
    "@types/lodash-es": "^4.17.12",
    "typescript": "^5.9.3"
  }
}
